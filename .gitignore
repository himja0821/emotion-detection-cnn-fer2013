# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Data — the FER-2013 CSV is 301 MB (over GitHub's 100 MB per-file limit) so
# it stays out of the repo. The msambare-style train/ test/ folders are
# regenerated by scripts/prepare_data.py.
data/fer2013/*.csv
data/fer2013/train/
data/fer2013/test/

# Model artifacts (.h5 and .npz are redundant copies of the primary .keras)
models/*.h5
models/*.npz

# Logs only
results/*.log
results/*.pid

# Final Word report — kept local only, not published to GitHub
docs/Deep_Learning_Project_Report.docx

